# Set a long, unique admin password before running/deploying.
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Google Sheets is the primary database.
STORAGE_BACKEND=google_sheets
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-the-id-from-the-sheet-url
# Paste the full service-account JSON as a single-line JSON string. Keep it secret.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_PUBLICATIONS_TAB=publications
GOOGLE_SHEETS_PROGRAMS_TAB=staff_programs
GOOGLE_SHEETS_AUDIT_TAB=changes

# Alternative without a Google Cloud service account:
# STORAGE_BACKEND=apps_script
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# GOOGLE_APPS_SCRIPT_API_KEY=YOUR_SECRET_API_KEY
